# Local development only. Do NOT commit real values.
# On Cloud Run these are set as env vars in the service, and GEMINI_API_KEY
# comes from Secret Manager instead.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_API_KEY=paste-your-aistudio-key-here

# Firebase web config (all values are safe to expose publicly — security comes
# from Firestore rules + Firebase Auth, not from hiding these).
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-gcp-project-id

# Path to a service account key JSON for local Firestore / Firebase Admin.
# Not needed if you run `gcloud auth application-default login` instead.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
